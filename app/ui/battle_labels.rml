<rml>
<head>
    <title>Battle labels</title>
    <!-- Labels over the fighters during a battle's playback (app/features/battle_labels.cpp):
         a mod's image when it gives one, else its word in its color. Positions are window
         pixels; the view writes them each frame. -->
    <style>
        body {
            width: 100%;
            height: 100%;
            pointer-events: none;
            font-family: LatoLatin;
        }
        #labels { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
        /* No transforms: the render interface has none (organize.rcss); the
           view sets each label's box. */
        .word {
            position: absolute;
            font-weight: bold;
            white-space: nowrap;
            text-align: center;
            font-effect: outline(2px #1A1206);
        }
        .art {
            position: absolute;
        }
    </style>
</head>
<body>
    <div id="labels"></div>
</body>
</rml>
