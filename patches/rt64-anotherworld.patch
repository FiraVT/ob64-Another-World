diff --git a/src/hle/rt64_rsp.cpp b/src/hle/rt64_rsp.cpp
index 1da2550..fd44344 100644
--- a/src/hle/rt64_rsp.cpp
+++ b/src/hle/rt64_rsp.cpp
@@ -14,6 +14,20 @@
 
 #include "rt64_interpreter.h"
 #include "rt64_state.h"
+#include <atomic>
+
+// OGRE: mission-field frame interpolation (docs/notes-frame-interpolation.md in
+// the port). The app turns this on while scene 0x03 runs with FRAME RATE set to
+// DISPLAY. The game builds its camera in the projection stack (bank N
+// func_ovlN_801C0D20: a G_MTX projection load of guPerspective, then a
+// projection multiply of guLookAt), so each projection load gets a fixed id and
+// RT64 pairs a frame's camera only with the previous frame's camera of the same
+// id. Model matrices stay G_EX_ID_AUTO, RT64's own matching.
+static std::atomic<bool> ogreFieldTags{ false };
+
+extern "C" void rt64_ogre_set_field_tags(bool enabled) {
+    ogreFieldTags.store(enabled, std::memory_order_relaxed);
+}
 
 //#define LOG_SPECIAL_MATRIX_OPERATIONS
 
@@ -187,7 +201,26 @@ namespace RT64 {
         modelViewProjChanged = true;
     }
 
+    // OGRE: give the projection load the id kOgreCameraId + n, where n counts
+    // the projection loads of this display list. The field's 3D camera is the
+    // first one; a later load (an orthographic 2D pass) gets its own id, so the
+    // two are never interpolated into each other when the number of passes
+    // changes between frames.
+    void RSP::ogreTagProjection(uint8_t params) {
+        constexpr uint32_t kOgreCameraId = 0x0B640000;
+        if (!ogreFieldTags.load(std::memory_order_relaxed) || !(params & projMask) || !(params & loadMask)) {
+            return;
+        }
+
+        const uint32_t id = kOgreCameraId + extended.ogreProjectionLoads++;
+        matrixId(id, false, true, false,
+            G_EX_COMPONENT_INTERPOLATE, G_EX_COMPONENT_INTERPOLATE, G_EX_COMPONENT_INTERPOLATE, G_EX_COMPONENT_INTERPOLATE, G_EX_COMPONENT_INTERPOLATE,
+            G_EX_COMPONENT_SKIP, G_EX_COMPONENT_SKIP, G_EX_COMPONENT_AUTO, G_EX_COMPONENT_AUTO,
+            G_EX_ORDER_LINEAR, G_EX_ASPECT_AUTO, G_EX_EDIT_NONE, false, false);
+    }
+
     void RSP::matrix(uint32_t address, uint8_t params) {
+        ogreTagProjection(params);
         const uint32_t rdramAddress = fromSegmentedMasked(address);
         const FixedMatrix *fixedMatrix = reinterpret_cast<FixedMatrix *>(state->fromRDRAM(rdramAddress));
         const hlslpp::float4x4 floatMatrix = fixedMatrix->toMatrix4x4();
@@ -1293,6 +1326,7 @@ namespace RT64 {
         extended.baseSegmentAddresses = {};
         extended.vertexSegmentEnabled = {};
         extended.forceBranch = false;
+        extended.ogreProjectionLoads = 0;
     }
 
     void RSP::setGBI(GBI *gbi) {
