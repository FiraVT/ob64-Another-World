+void recomp::overlays::register_bank_hook_sections(const BankHookSection* sections, size_t count) {
+    // Entries are copied. The app registers again on every game start, which
+    // replaces each record with the same values.
+    for (size_t i = 0; i < count; i++) {
+        bank_hook_sections.insert_or_assign(sections[i].rom_addr, sections[i]);
+    }
+}
+
+const recomp::overlays::BankHookSection* recomp::overlays::get_bank_hook_section(uint32_t rom_addr) {
+    auto find_it = bank_hook_sections.find(rom_addr);
+    if (find_it == bank_hook_sections.end()) {
+        return nullptr;
+    }
+    return &find_it->second;
+}
+
+bool recomp::overlays::get_bank_hook_func_entry(uint32_t rom_addr, uint32_t function_vram, FuncEntry& func_out) {
+    const BankHookSection* section = get_bank_hook_section(rom_addr);
+    if (section == nullptr) {
+        return false;
+    }
+    uint32_t function_offset = function_vram - (uint32_t)section->ram_addr;
+    if (function_offset >= section->size) {
+        return false;
+    }
+    for (size_t func_index = 0; func_index < section->num_funcs; func_index++) {
+        const BankFunctionEntry& entry = section->funcs[func_index];
+        if ((uint32_t)entry.ram_addr == function_vram) {
+            func_out = FuncEntry{ .func = entry.func, .offset = function_offset, .rom_size = entry.rom_size };
+            return true;
+        }
+    }
+    return false;
+}
