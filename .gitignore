# ROM and derived assets (never commit copyrighted material)
assets/
# Disassembly made by `splat split` from the ROM; rebuild it with the split step.
asm/
# Screenshots of the game (its artwork); kept locally, not published.
docs/proofs/
# Extracted backdrop references (tools/backgrounds.py writes the game's own
# images here so HD replacements can be drawn over them).
mods/backgrounds/reference/

# Generated artifacts
build/
build-app/
build-null/
build-dist/
dist/
RecompiledFuncs/
# Streamed-overlay bank units (Phase 4): N64Recomp output for
# config/banks/config-bank<U>.toml, plus the table tools/gen_bank_funcs.py
# derives from it.
Bank*Funcs/
app/src/bank_funcs.inc
# RSPRecomp output (config/rsp-njpeg.toml), regenerated by `make rsp-recomp`.
RspFuncs/
# US revision 0's recompiled code, generated by `make rev0` (tools/rev0_gen.py).
rev0/
# splat's linker dependency file for ogrebattle64.ld (`ld_dependencies`).
ogrebattle64.d
*.bin
*.elf
*.map
*.o

# Example mods: the base symbol dump (`make mod-syms`) is generated from the
# linked ELF, and each mod's MIPS object/ELF is built by `make example-mods`.
mods/reference/*.toml
mods/*/build/

# Third-party tooling (see README.md for setup)
tools/venv/
tools/N64Recomp/
tools/N64ModernRuntime/
tools/RecompFrontend/
# `make sdl2-static`: the pinned real SDL2 fetched and built for a static link
# (Homebrew's sdl2 on macOS is sdl2-compat, which has no static library).
tools/SDL2-static/
# The MIPS cross toolchain unpacked by the Windows setup (312 MB of binaries).
tools/mips-binutils/
# Release folders made by hand beside the source (they hold ROMs and saves).
Release/
# Reference pages (mission enemy squads, class details) collected from outside
# sources. They stay on the developer's disk for tools/squad_stats.py and the
# balance notes, and are not published: their text belongs to its authors.
docs/overhaul/
gameinfo/
# Tables generated from the ROM (game data); rebuild them with the tools named
# in their headers: tools/mission_data.py and tools/class_catalog.py.
docs/mission-enemies.md
docs/class-catalog.md
# RT64 is a git submodule (git submodule update --init tools/RT64)


# Captured artifacts of the debug/ scripts
debug/out/

# Python bytecode
__pycache__/
*.pyc

# Local `OGRE_PREF_DIR` sandboxes (saves/, mods/) used by scripted runs
.ogre-prefs*/


# OS junk
.DS_Store

# Android build (tools/build.sh android): the CMake tree, the staged native
# libraries and mods, and Gradle's own output.
build-android/
android/local.properties
android/.gradle/
android/app/build/
android/app/src/main/jniLibs/
android/app/src/main/assets/

# Run logs the app and sessions write beside the source.
*.log


# New class template art: made from the ROM with tools/export_class_art.py
# (extracted game art is never committed).
app/content/examples/*/art/*.png

# JetBrains Rider project folder
.idea/
